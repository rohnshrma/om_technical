# --- MongoDB (required) ---
# Free tier: create an M0 cluster at https://www.mongodb.com/cloud/atlas/register
# Get the connection string from Atlas -> Connect -> Drivers, then append a
# database name of your choice (or leave it to default to "om_technical").
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=om_technical

# --- Admin auth (required) ---
# JWT_SECRET: any long random string (e.g. `openssl rand -base64 32`).
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=ommtechmgtofficial@gmail.com
# Generate this with: npm run hash-password -- "YourStrongPassword123"
# IMPORTANT: the script prints two versions. In a LOCAL .env.local file you
# must use the backslash-escaped one (\$2b\$10\$...) — Next.js's env loader
# otherwise treats the bare $ characters in a bcrypt hash as variable
# interpolation and silently truncates the value. In Vercel's dashboard,
# paste the hash as-is (no escaping) — it does not do that interpolation.
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-from-hash-password-script

# --- Site URL (required for SEO metadata, sitemap, schema.org) ---
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.in

# --- Google Search Console verification (optional) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Resend email notifications for new leads (optional, free tier) ---
# Leave blank to skip email notifications — leads are always saved to the database regardless.
RESEND_API_KEY=
RESEND_FROM_EMAIL=OM Technical Website <onboarding@resend.dev>
LEAD_NOTIFICATION_EMAIL=ommtechmgtofficial@gmail.com
